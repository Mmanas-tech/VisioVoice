# Application
APP_NAME=Lip-Reading AI Backend
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lipread_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=60

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AWS S3 (optional - uses local storage if not set)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=lipread-videos
AWS_REGION=us-east-1

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage

# ML Model
MODEL_PATH=./models/lip_reading_model.pth
MODEL_DEVICE=cpu

# Upload Limits
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_VIDEO_TYPES=.mp4,.mov,.avi,.mkv

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_FAILED_LOGIN=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database Connection (for direct access)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lipread_db
DB_USER=postgres
DB_PASSWORD=postgres
